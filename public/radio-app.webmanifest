{
  "name": "Radio Bethel Chile - App",
  "short_name": "Radio Bethel",
  "description": "Escucha Radio Bethel Chile en vivo - Radio cristiana con predicaciones, música de adoración y estudios bíblicos las 24 horas del día.",
  "start_url": "/radio",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#10b981",
  "background_color": "#0c2a44",
  "categories": ["music", "religion", "lifestyle", "entertainment"],
  "lang": "es-CL",
  "dir": "ltr",
  "icons": [
    {
      "src": "/favicon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/images/radio-screenshot-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Radio Bethel Chile - Vista principal de la app"
    }
  ],
  "shortcuts": [
    {
      "name": "Radio en Vivo",
      "short_name": "Radio",
      "description": "Escuchar radio en vivo",
      "url": "/radio",
      "icons": [
        {
          "src": "/favicon-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Programación",
      "short_name": "Programas",
      "description": "Ver programación de la radio",
      "url": "/radio#programacion",
      "icons": [
        {
          "src": "/favicon-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Eventos",
      "short_name": "Eventos",
      "description": "Ver próximos eventos",
      "url": "/eventos",
      "icons": [
        {
          "src": "/favicon-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Iglesias",
      "short_name": "Iglesias",
      "description": "Encontrar iglesias cercanas",
      "url": "/iglesias",
      "icons": [
        {
          "src": "/favicon-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "share_target": {
    "action": "/radio",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+radiobethel",
      "url": "/radio?stream=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/radio",
      "accept": {
        "audio/mpeg": [".mp3"],
        "audio/ogg": [".ogg"],
        "audio/wav": [".wav"]
      }
    }
  ]
}
